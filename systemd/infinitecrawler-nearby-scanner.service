[Unit]
Description=InfiniteCrawler Nearby Search grid-scanner (multi-key)
Documentation=https://github.com/monjurkuet/infinitecrawler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/codebase/vhd/infinitecrawler
EnvironmentFile=/root/codebase/vhd/infinitecrawler/.env
Environment=PG_HOST=/var/run/postgresql
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/.local/bin/uv run python -m daemons.nearby_scanner_daemon
ExecStop=/bin/kill -TERM $MAINPID
Restart=always
RestartSec=10
StartLimitIntervalSec=0
StartLimitBurst=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ic-nearby-scanner

TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes

[Install]
WantedBy=default.target
