[Unit]
Description=InfiniteCrawler Places API listing daemon (multi-key, no browser)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/codebase/vhd/infinitecrawler
Environment=PG_HOST=/var/run/postgresql
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/codebase/vhd/infinitecrawler/.venv/bin/python3 -m daemons.places_api_daemon
Restart=always
RestartSec=10
StandardOutput=append:/var/log/infinitecrawler/places-api-daemon.log
StandardError=append:/var/log/infinitecrawler/places-api-daemon.log

[Install]
WantedBy=default.target
