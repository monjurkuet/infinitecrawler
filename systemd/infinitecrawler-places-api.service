[Unit]
Description=InfiniteCrawler Places API listing daemon (multi-key, no browser)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/run/media/growloop/codebase/infinitecrawler
Environment=PG_HOST=/var/run/postgresql
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/growloop/.hermes/bin/uv run python -m daemons.places_api_daemon
Restart=always
RestartSec=10
StandardOutput=append:/var/log/infinitecrawler/places-api-daemon.log
StandardError=append:/var/log/infinitecrawler/places-api-daemon.log

[Install]
WantedBy=default.target
