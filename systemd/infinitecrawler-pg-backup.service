[Unit]
Description=InfiniteCrawler PostgreSQL database backup
Documentation=https://github.com/monjurkuet/infinitecrawler
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/run/media/growloop/codebase/infinitecrawler/scripts/backup-pg.sh
WorkingDirectory=/run/media/growloop/codebase/infinitecrawler
EnvironmentFile=-%h/.config/infinitecrawler/backup.env
