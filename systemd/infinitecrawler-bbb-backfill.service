[Unit]
Description=InfiniteCrawler BBB Backfill (website enrichment for legacy rows)
After=network-online.target postgresql.service redis.service
RequiresMountsFor=/run/media/growloop/codebase/infinitecrawler
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/run/media/growloop/codebase/infinitecrawler
EnvironmentFile=/run/media/growloop/codebase/infinitecrawler/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/growloop/.venvs/ic/bin/python3 /run/media/growloop/codebase/infinitecrawler/scripts/bbb_backfill.py
Restart=always
RestartSec=120
MemoryMax=250M
StandardOutput=append:/var/log/infinitecrawler/infinitecrawler-bbb-backfill.log
StandardError=append:/var/log/infinitecrawler/infinitecrawler-bbb-backfill.log

[Install]
WantedBy=default.target
