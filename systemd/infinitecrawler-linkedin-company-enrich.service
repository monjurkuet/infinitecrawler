[Unit]
Description=InfiniteCrawler LinkedIn Company Enrichment — perpetual free scraper of linkedin.com/company pages
Documentation=https://github.com/monjurkuet/infinitecrawler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/codebase/vhd/infinitecrawler
EnvironmentFile=%h/codebase/vhd/infinitecrawler/.env
ExecStart=/root/.local/bin/uv run python scripts/db_linkedin_company_enrich.py --loop --loop-gap 120 --max 30 --concurrency 2
Restart=always
RestartSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ic-li-enrich

[Install]
WantedBy=default.target
