[Unit]
Description=InfiniteCrawler LinkedIn Company Enrichment — perpetual free scraper of linkedin.com/company pages
Documentation=https://github.com/monjurkuet/infinitecrawler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/run/media/growloop/codebase/infinitecrawler
EnvironmentFile=/run/media/growloop/codebase/infinitecrawler/.env
ExecStart=/home/growloop/.hermes/bin/uv run python scripts/db_linkedin_company_enrich.py --loop --loop-gap 120 --max 30 --concurrency 2
Restart=always
RestartSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ic-li-enrich

[Install]
WantedBy=default.target
