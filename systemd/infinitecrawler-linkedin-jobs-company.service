[Unit]
Description=InfiniteCrawler LinkedIn company detail daemon (job slugs → linkedin_companies)
After=postgresql.service
RequiresMountsFor=/run/media/growloop/codebase/infinitecrawler

[Service]
Type=simple
WorkingDirectory=/run/media/growloop/codebase/infinitecrawler
EnvironmentFile=/run/media/growloop/codebase/infinitecrawler/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/growloop/.venvs/ic/bin/python3 -m daemons.linkedin_company_daemon --loop
Restart=on-failure
RestartSec=60
MemoryMax=300M
StandardOutput=append:/var/log/infinitecrawler/infinitecrawler-linkedin-jobs-company.log
StandardError=append:/var/log/infinitecrawler/infinitecrawler-linkedin-jobs-company.log

[Install]
WantedBy=default.target