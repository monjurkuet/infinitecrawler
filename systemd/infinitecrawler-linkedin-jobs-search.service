[Unit]
Description=InfiniteCrawler LinkedIn jobs search daemon (guest API → Redis queue)
After=postgresql.service
RequiresMountsFor=/run/media/growloop/codebase/infinitecrawler

[Service]
Type=simple
WorkingDirectory=/run/media/growloop/codebase/infinitecrawler
EnvironmentFile=/run/media/growloop/codebase/infinitecrawler/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/growloop/.venvs/ic/bin/python3 -m daemons.linkedin_search_daemon --loop
Restart=on-failure
RestartSec=60
MemoryMax=250M
StandardOutput=append:/var/log/infinitecrawler/infinitecrawler-linkedin-jobs-search.log
StandardError=append:/var/log/infinitecrawler/infinitecrawler-linkedin-jobs-search.log

[Install]
WantedBy=default.target