[Unit]
Description=InfiniteCrawler OSM Geofabrik/Overpass weekly import — refreshes OSM business POIs in scraper.gmaps_listings
Documentation=https://github.com/monjurkuet/infinitecrawler
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/run/media/growloop/codebase/infinitecrawler
EnvironmentFile=/run/media/growloop/codebase/infinitecrawler/.env
Environment=PG_HOST=/var/run/postgresql
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/growloop/.hermes/bin/uv run python scripts/osm_import.py
TimeoutStartSec=7200
StandardOutput=journal
StandardError=journal
