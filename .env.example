# Environment variables for docker-compose

# PostgreSQL Configuration (remote VPS or local)
PG_HOST=your-vps-host.com
PG_PORT=5432
PG_USER=infinitecrawler
PG_PASSWORD=your-secure-password-here
PG_DB=infinitecrawler

# Redis Configuration (local or remote)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# API Configuration
INFINITECRAWLER_API_HOST=0.0.0.0
INFINITECRAWLER_API_PORT=8015
INFINITECRAWLER_API_TOKEN=your-secure-api-token-here

# Pinchtab Configuration (for daemon integration)
PINCHTAB_HOST=localhost
PINCHTAB_PORT=9868
PINCHTAB_TOKEN=your-pinchtab-token-here

# Python Configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Google Places API (New) — multi-key rotation
# Comma-separated list of API keys from separate Google Cloud projects.
# Each key: 200/day per method (GetPlace, Text Search, Nearby Search).
# Override the api_keys list in config/places_api_daemon.yaml and config/nearby_scanner.yaml.
PLACES_API_KEYS=YOUR_KEY_1,YOUR_KEY_2,YOUR_KEY_3

# LLM Classification
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://your-llm-endpoint/v1
LLM_CLASSIFIER_MODEL=deepseek-ai/deepseek-v4-flash

# Places API daemon tuning
PLACES_EXHAUSTED_SLEEP=600
NEARBY_EXHAUSTED_SLEEP=600
